# backend/.env additions for production.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.gadgetsgarden.ng

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_DATABASE=gadgetsgarden
DB_USERNAME=gadgetsgarden
DB_PASSWORD=

# Database-backed so the worker survives a restart with jobs still queued.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# CORS is an explicit allowlist — never '*'.
STOREFRONT_URL=https://gadgetsgarden.ng
BACKOFFICE_URL=https://admin.gadgetsgarden.ng

# --- Payments -----------------------------------------------------------
# `mock` settles orders on request and authenticates nothing. Never here.
SHOP_PAYMENT_PROVIDER=xendify
SHOP_UNPAID_ORDER_TTL_HOURS=24
SHOP_XENDIFY_BASE_URL=https://api.xendify.com/api/v1
SHOP_XENDIFY_SECRET_KEY=
# Unset means every webhook 401s and nothing settles — deliberately.
SHOP_XENDIFY_WEBHOOK_KEY=
SHOP_XENDIFY_PROVIDER=safehaven

# --- Mail ---------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@gadgetsgarden.ng"
MAIL_FROM_NAME="Gadgets Garden"
